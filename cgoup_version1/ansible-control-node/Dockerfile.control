FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ansible-core \
        openssh-client \
        sshpass \
        git \
        curl \
        vim \
        nano \
        less \
        iputils-ping \
        python3 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash ansible

USER ansible
WORKDIR /training

CMD ["sleep", "infinity"]

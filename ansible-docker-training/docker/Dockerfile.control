FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ansible-core \
        openssh-client \
        sshpass \
        git \
        curl \
        vim \
        nano \
        less \
        iputils-ping \
        python3 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash ansible

RUN mkdir -p /home/ansible/.ssh

COPY ssh/id_ed25519 /home/ansible/.ssh/id_ed25519
COPY ssh/id_ed25519.pub /home/ansible/.ssh/id_ed25519.pub

RUN chown -R ansible:ansible /home/ansible/.ssh \
    && chmod 700 /home/ansible/.ssh \
    && chmod 600 /home/ansible/.ssh/id_ed25519 \
    && chmod 644 /home/ansible/.ssh/id_ed25519.pub

USER ansible
WORKDIR /training

CMD ["bash"]
